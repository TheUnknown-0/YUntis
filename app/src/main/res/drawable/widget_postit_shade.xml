<?xml version="1.0" encoding="utf-8"?>
<!-- A light fall of shadow towards the bottom, as on a real sticky note. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#00000000"
        android:centerY="0.55"
        android:endColor="#1F000000"
        android:startColor="#0AFFFFFF" />
    <corners android:radius="3dp" android:bottomRightRadius="14dp" />
</shape>
